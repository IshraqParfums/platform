# Nest API origin used by the Next BFF (server).
NEST_API_BASE_URL=http://localhost:3001

# Supabase project URL — also used by next.config to allow Storage image hosts
# for `next/image` (no hardcoded project ref in next.config).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Optional comma-separated extra image hosts (e.g. another Supabase project).
# IMAGE_REMOTE_HOSTS=abcdefgh.supabase.co
