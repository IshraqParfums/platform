# Application
PORT=3001
# Set to 1 when Nest sits behind a reverse proxy / load balancer so req.ip
# reflects the real client (used for bespoke session create rate limits).
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Required to start (missing → process refuses to boot)
# ---------------------------------------------------------------------------

# Supabase Postgres
# DATABASE_URL — pooled connection for the Nest app (Supabase "Transaction" pooler, port 6543)
# DIRECT_URL   — direct connection for Prisma Migrate (Supabase "Direct", port 5432)
#
# Replace with values from Supabase → Project Settings → Database.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Customer JWT (HS256)
JWT_SECRET="change-me-customer-jwt-secret"

# ---------------------------------------------------------------------------
# Feature credentials (missing → HTTP 503 on that feature only; app still boots)
# ---------------------------------------------------------------------------

# Customer OTP sign-in
OTP_PEPPER="change-me-otp-pepper"

# Razorpay checkout / webhooks
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="change-me-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="change-me-razorpay-webhook-secret"

# Supabase Auth (admin JWT verification + admin login proxy)
# SUPABASE_JWT_SECRET — Project Settings → API → JWT Secret (legacy HS256 only).
#   Newer projects sign *user* access tokens with ES256; Nest verifies those via
#   JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json (see AdminJwtGuard).
# SUPABASE_ANON_KEY   — Project Settings → API → anon/public key (used server-side to call
#                        Supabase Auth's password grant on the admin's behalf; safe to be
#                        the "public" key since it carries no elevated privileges)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET="change-me-supabase-jwt-secret"
SUPABASE_ANON_KEY="change-me-supabase-anon-key"

# Supabase Storage (product image uploads — server-side only, never send to any client)
# SUPABASE_SERVICE_ROLE_KEY — Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY="change-me-supabase-service-role-key"

# Business-rule values (OTP throttling, checkout timing, shipping, bespoke pricing,
# JWT lifetime, storage bucket name, etc.) are no longer env-configurable — they're
# constants in their owning module (e.g. src/modules/order/order.constants.ts,
# src/modules/auth/otp/otp.constants.ts). Change them in code + redeploy, not here.
