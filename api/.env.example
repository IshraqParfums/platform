# Application
PORT=3001

# Supabase Postgres
# DATABASE_URL — pooled connection for the Nest app (Supabase "Transaction" pooler, port 6543)
# DIRECT_URL   — direct connection for Prisma Migrate (Supabase "Direct", port 5432)
#
# Replace with values from Supabase → Project Settings → Database.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Customer JWT (HS256)
JWT_SECRET="change-me-customer-jwt-secret"
JWT_EXPIRES_IN=7d

# Supabase Auth (admin JWT verification)
# SUPABASE_JWT_SECRET — Project Settings → API → JWT Secret
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET="change-me-supabase-jwt-secret"

# Supabase Storage (product image uploads — server-side only, never send to any client)
# SUPABASE_SERVICE_ROLE_KEY — Project Settings → API → service_role key
# SUPABASE_STORAGE_BUCKET   — public bucket for product images (default "product-images")
SUPABASE_SERVICE_ROLE_KEY="change-me-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET=product-images

# OTP (hashed at rest; never returned in API responses)
OTP_PEPPER="change-me-otp-pepper"
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_15_MIN=5
OTP_MAX_PER_DAY=10
OTP_MAX_VERIFY_ATTEMPTS=5

# Checkout / shipping (paise). Flat ₹50 for V1; replaceable later.
SHIPPING_PAISE=5000
CHECKOUT_RAZORPAY_WINDOW_SECONDS=600
CHECKOUT_RESERVATION_TTL_SECONDS=660

# Bespoke pricing (paise). Default ₹10/ml; sizes 30,50,100 ml.
BESPOKE_PAISE_PER_ML=1000
BESPOKE_ALLOWED_SIZES_ML=30,50,100

# Razorpay (test keys in development)
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="change-me-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="change-me-razorpay-webhook-secret"
