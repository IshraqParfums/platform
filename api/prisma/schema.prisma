generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
}

enum ProductArchiveReason {
  MANUAL
  COLLECTION
}

enum OrderStatus {
  PENDING_PAYMENT
  EXPIRED
  FAILED
  NEEDS_REVIEW
  ORDER_RECEIVED
  CONFIRMED
  IN_PRODUCTION
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum PaymentProvider {
  RAZORPAY
}

model Collection {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description    String?
  editorialLabel String?
  status         CollectionStatus @default(ACTIVE)
  /// Admin-curated homepage slot, 1-based. Null = not shown on the homepage.
  /// No DB uniqueness constraint — the homepage query takes the first three by
  /// ascending rank, so a duplicate is a curation mistake, not a data error.
  homeRank    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    Product[]

  @@index([status])
  @@index([status, homeRank])
  @@map("collections")
}

model Product {
  id                  String                @id @default(uuid())
  collectionId        String
  name                String
  /// Urdu (Nastaliq) product name. Display-only sidecar — the storefront renders
  /// it beside the Latin name; nothing keys off it and search still uses `name`.
  nameUrdu            String?
  slug                String                @unique
  shortDescription    String
  detailedDescription String
  status              ProductStatus         @default(DRAFT)
  archiveReason       ProductArchiveReason?
  /// 10-dimension scent profile (0–4) for bespoke catalogue_select nodes.
  scentProfileJson    Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  collection          Collection            @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  variants            ProductVariant[]
  images              ProductImage[]
  reviews             Review[]

  @@index([status])
  @@index([collectionId])
  @@index([collectionId, status, archiveReason])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id                  String      @id @default(uuid())
  productId           String
  sizeMl              Int
  pricePaise          Int
  compareAtPricePaise Int?
  stockQty            Int         @default(0)
  reservedQty         Int         @default(0)
  sku                 String?
  isAvailable         Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  product             Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@unique([productId, sizeMl])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  url          String
  storagePath  String?
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, displayOrder])
  @@map("product_images")
}

model Customer {
  id              String                 @id @default(uuid())
  phone           String                 @unique
  email           String?                @unique
  name            String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  cart            Cart?
  addresses       CustomerAddress[]
  orders          Order[]
  reviews         Review[]
  bespokePerfumes BespokePerfume[]
  bespokeSessions BespokeSession[]
  refreshTokens   CustomerRefreshToken[]

  @@map("customers")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_addresses")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  productVariantId String?
  bespokePerfumeId String?
  bespokeSizeMl    Int?
  quantity         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  bespokePerfume   BespokePerfume? @relation(fields: [bespokePerfumeId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@unique([cartId, bespokePerfumeId, bespokeSizeMl])
  @@index([cartId])
  @@index([bespokePerfumeId])
  @@map("cart_items")
}

model Order {
  id                 String      @id @default(uuid())
  customerId         String
  status             OrderStatus @default(PENDING_PAYMENT)
  customerName       String
  customerEmail      String
  shippingName       String
  shippingPhone      String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPincode    String
  subtotalPaise      Int
  shippingPaise      Int
  totalPaise         Int
  expiresAt          DateTime
  razorpayOrderId    String?     @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  payment            Payment?

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  productVariantId String?
  bespokePerfumeId String?
  productName      String
  productSlug      String
  sizeMl           Int
  unitPricePaise   Int
  quantity         Int
  lineTotalPaise   Int
  formulaJson      Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  bespokePerfume   BespokePerfume? @relation(fields: [bespokePerfumeId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([bespokePerfumeId])
  @@map("order_items")
}

model BespokePerfume {
  id            String          @id @default(uuid())
  customerId    String
  name          String
  dedication    String?
  /// Composite v2 snapshot: bottle + sample + fingerprint + colorTheme.
  formulaJson   Json
  stateJson     Json
  colorThemeJson Json
  graphVersion  String
  engineVersion String
  clientKey     String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  sessions      BespokeSession[]

  @@unique([customerId, clientKey])
  @@index([customerId, createdAt])
  @@index([deletedAt])
  @@map("bespoke_perfumes")
}

enum BespokeSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CLAIMED
}

model BespokeSession {
  id               String               @id @default(uuid())
  tokenHash        String               @unique
  customerId       String?
  stateJson        Json
  historyJson      Json
  shortlistJson    Json?
  resultJson       Json?
  status           BespokeSessionStatus @default(ACTIVE)
  version          Int                  @default(0)
  expiresAt        DateTime
  bespokePerfumeId String?
  ipHash           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  customer         Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bespokePerfume   BespokePerfume?      @relation(fields: [bespokePerfumeId], references: [id], onDelete: SetNull)
  events           BespokeQuizEvent[]

  @@index([customerId])
  @@index([customerId, status])
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  @@index([bespokePerfumeId])
  @@map("bespoke_sessions")
}

model BespokeQuizEvent {
  id         String         @id @default(uuid())
  sessionId  String
  type       String
  nodeId     String
  nodeText   String
  optionIds  String[]       @default([])
  optionLabels String[]     @default([])
  at         DateTime       @default(now())
  session    BespokeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([at])
  @@map("bespoke_quiz_events")
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @unique
  provider          PaymentProvider @default(RAZORPAY)
  razorpayOrderId   String
  razorpayPaymentId String?         @unique
  amountPaise       Int
  status            PaymentStatus   @default(CREATED)
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([razorpayOrderId])
  @@map("payments")
}

model Review {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  rating     Int
  title      String?
  body       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId])
  @@index([productId, createdAt])
  @@map("reviews")
}

model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model Admin {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique
  email          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("admins")
}
